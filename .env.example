# === Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespw
POSTGRES_DB=projectdb
DATABASE_URL=postgresql://postgres:postgrespw@localhost:5432/projectdb?schema=public
POSTGRES_HOST_PORT=5433
PGBOUNCER_HOST_PORT=6433
REDIS_HOST_PORT=6380
NGINX_HOST_PORT=3002
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3003

# === Authentication ===
JWT_SECRET=ChangeThisToAStrongSecretValue

# === Seed Admin ===
SEED_ADMIN_EMAIL=admin@smart-dormitory.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin

# === Redis ===
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# === Queues ===
ACCESS_LOG_QUEUE_KEY=dormitory:access-logs
ACCESS_LOG_BATCH_SIZE=100
ACCESS_LOG_FLUSH_INTERVAL_MS=1000
OCR_JOB_QUEUE_KEY=dormitory:ocr-jobs
OCR_JOB_WORKER_INTERVAL_MS=1000
OCR_JOB_WORKER_BATCH_SIZE=5

# === File Storage ===
UPLOAD_ROOT=/app/uploads/private

# === External APIs ===
OCR_API_BASE_URL=https://your-ocr-api-url.com
OCR_API_KEY=your_ocr_api_key_here
OCR_TIMEOUT_MS=10000
OCR_RETRY_ATTEMPTS=2
OCR_RETRY_DELAY_MS=250
OCR_CIRCUIT_FAILURE_THRESHOLD=5
OCR_CIRCUIT_OPEN_MS=30000
FACE_API_URL=https://your-face-api-url.com
FACE_API_KEY=your_face_api_key_here
