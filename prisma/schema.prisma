datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/**
 * ---------- Existing Enums ----------
 */
enum Role {
  ADMIN
  STUDENT
  VISITOR
}

enum OcrJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// แบบจ่ายบิลเดียว
enum PaymentStatus {
  PENDING
  VERIFYING
  PAID
  FAILED
  MANUAL_REVIEW
}

enum PaymentProvider {
  THUNDER
}

// แบบจ่ายหลายบิลพร้อมกัน
enum PaymentBatchStatus {
  PENDING
  VERIFYING
  PAID
  FAILED
  MANUAL_REVIEW
}

/**
 * ---------- Existing User Model ----------
 */
model User {
  faceRevokedAt               DateTime?
  id                          Int       @id @default(autoincrement())
  username                    String?   @unique
  email                       String    @unique
  phone                       String?   @unique
  password                    String
  passwordResetOtpHash        String?   @unique
  passwordResetOtpExpiresAt   DateTime?
  passwordResetOtpAttempts    Int       @default(0)
  passwordResetGrantHash      String?   @unique
  passwordResetGrantExpiresAt DateTime?
  role                        Role      @default(STUDENT)
  lastLogin                   DateTime?
  authSessionVersion          Int       @default(1) // Authentication only; independent of data OCC
  version                     Int       @default(1) // Optimistic Concurrency Control (OCC)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // Relations
  accessLogs                    AccessLog[]
  transactions                  Transaction[]
  payments                      Payment[]
  paymentBatches                PaymentBatch[]
  idCardVerifications           IdCardVerification[]
  ocrJobs                       OcrJob[]
  tenant                        Tenant?
  housingDraft                  HousingApplicationDraft?
  housingRefundsRecorded        HousingRefund[]          @relation("HousingRefundRecorder")
  housingRefundRequestsResolved HousingRefundRequest[]   @relation("HousingRefundRequestResolver")
  faceEmbeddings                FaceEmbedding[]
  faceEnrollmentPhotos          FaceEnrollmentPhoto[]
  updatedSettings               SystemSetting[]
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([updatedById])
}

/**
 * ---------- New AccessLog Model ----------
 */
model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  method    String
  path      String
  ip        String?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
}

/**
 * ---------- New Transaction Model ----------
 */
model Transaction {
  id          Int             @id @default(autoincrement())
  userId      Int?
  user        User?           @relation(fields: [userId], references: [id])
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/**
 * ---------- Sensitive Document Verification Metadata ----------
 */
model IdCardVerification {
  id               Int       @id @default(autoincrement())
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id])
  imagePath        String?
  isThaiIdCard     Boolean
  citizenIdMasked  String?
  citizenIdHash    String?
  fullNameTh       String?
  birthDateTh      String?
  issueDate        String?
  expiryDate       String?
  idDetected       Boolean   @default(false)
  idPresent        Boolean   @default(false)
  idChecksumValid  Boolean   @default(false)
  reason           String?
  ocrJobId         String?
  processingTimeMs Int?
  verifiedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  ocrJobs          OcrJob[]  @relation("OcrJobResultVerification")
  housingPayments  Payment[]

  @@index([userId])
  @@index([citizenIdHash])
  @@index([verifiedAt])
}

model OcrJob {
  id                   String              @id @default(uuid())
  userId               Int?
  user                 User?               @relation(fields: [userId], references: [id])
  status               OcrJobStatus        @default(PENDING)
  imagePath            String
  resultVerificationId Int?
  resultVerification   IdCardVerification? @relation("OcrJobResultVerification", fields: [resultVerificationId], references: [id])
  errorMessage         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  completedAt          DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([resultVerificationId])
}

/**
 * ---------- Transaction Type Enum ----------
 */
enum TransactionType {
  INCOME
  EXPENSE
}

/**
 * ---------- Dormitory Domain Enums ----------
 */
enum BillStatus {
  UNPAID
  VERIFYING
  PAID
  OVERDUE
  FAILED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  CLOSED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CLEANING
  SECURITY
  OTHER
}

enum VisitorStatus {
  REGISTERED
  VERIFYING
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

/**
 * ---------- Core Dormitory Models ----------
 */
model Room {
  id          Int      @id @default(autoincrement())
  roomNumber  String   @unique
  floor       Int?
  status      String   @default("AVAILABLE")
  capacity    Int      @default(4)
  monthlyRent Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants            Tenant[]
  bills              Bill[]
  maintenanceTickets MaintenanceTicket[]
  visitors           Visitor[]
  housingPayments    Payment[]

  @@index([roomNumber])
  @@index([status])
}

model Tenant {
  id                Int       @id @default(autoincrement())
  userId            Int?      @unique
  user              User?     @relation(fields: [userId], references: [id])
  roomId            Int?
  room              Room?     @relation(fields: [roomId], references: [id])
  fullName          String?
  phone             String?
  email             String?
  studentId         String?
  course            String?
  yearLevel         String?
  citizenId         String?
  address           String?
  birthDate         String?
  emergencyContact  String?
  emergencyName     String?
  emergencyRelation String?
  preferredRoomType String?
  notes             String?
  contractData      String? // JSON string storing full contract details
  idCardImagePath   String?
  paymentSlipPath   String?
  status            String    @default("PENDING")
  checkInDate       DateTime?
  checkOutDate      DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bills              Bill[]
  maintenanceTickets MaintenanceTicket[]
  visitors           Visitor[]
  housingPayments    Payment[]

  @@index([userId])
  @@index([roomId])
  @@index([isActive])
}

model Bill {
  id             Int        @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  roomId         Int?
  room           Room?      @relation(fields: [roomId], references: [id])
  amount         Decimal    @db.Decimal(10, 2)
  rentAmount     Decimal    @default(0) @db.Decimal(10, 2)
  electricAmount Decimal    @default(0) @db.Decimal(10, 2)
  waterAmount    Decimal    @default(0) @db.Decimal(10, 2)
  penaltyAmount  Decimal    @default(0) @db.Decimal(10, 2)
  dueDate        DateTime
  status         BillStatus @default(UNPAID)
  version        Int        @default(1)
  billingPeriod  String?    @db.VarChar(7) // Gregorian YYYY-MM; null for legacy bills
  description    String?
  slipHash       String?
  reason         String?
  paidAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  payments   Payment[]
  batchItems PaymentBatchItem[]

  @@unique([tenantId, roomId, billingPeriod])
  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id                    Int                      @id @default(autoincrement())
  billId                Int?
  bill                  Bill?                    @relation(fields: [billId], references: [id], onDelete: Restrict)
  housingRoomId         Int?
  housingRoom           Room?                    @relation(fields: [housingRoomId], references: [id], onDelete: Restrict)
  housingVerificationId Int?
  housingVerification   IdCardVerification?      @relation(fields: [housingVerificationId], references: [id], onDelete: Restrict)
  housingTenantId       Int?
  housingDraftId        Int?
  housingDraft          HousingApplicationDraft? @relation(fields: [housingDraftId], references: [id], onDelete: SetNull)
  housingApprovedAt     DateTime?
  housingTenant         Tenant?                  @relation(fields: [housingTenantId], references: [id], onDelete: Restrict)
  payerUserId           Int?
  payerUser             User?                    @relation(fields: [payerUserId], references: [id])
  amount                Decimal                  @db.Decimal(10, 2)
  status                PaymentStatus            @default(PENDING)
  provider              PaymentProvider          @default(THUNDER)
  providerTransactionId String?                  @unique
  idempotencyKey        String                   @unique
  slipHash              String?                  @unique
  slipPath              String?
  slipAmount            Decimal?                 @db.Decimal(10, 2)
  transferAt            DateTime?
  providerResponse      String?
  failureReason         String?
  verifiedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([billId])
  @@index([housingRoomId])
  @@index([housingVerificationId])
  @@index([housingTenantId])
  @@index([housingDraftId])
  @@index([payerUserId])
  @@index([status])
  @@index([createdAt])
}

model HousingApplicationDraft {
  id                Int                    @id @default(autoincrement())
  userId            Int                    @unique
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId            Int?
  roomHoldExpiresAt DateTime?
  data              Json                   @default("{}")
  status            String                 @default("OPEN")
  version           Int                    @default(1)
  payments          Payment[]
  refunds           HousingRefund[]
  refundRequests    HousingRefundRequest[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([roomId, status, roomHoldExpiresAt])
}

model HousingRefund {
  id             Int                     @id @default(autoincrement())
  draftId        Int
  draft          HousingApplicationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  amount         Decimal                 @db.Decimal(10, 2)
  reference      String                  @unique @db.VarChar(100)
  idempotencyKey String                  @unique
  proofHash      String                  @unique
  proofPath      String
  recordedById   Int?
  recordedBy     User?                   @relation("HousingRefundRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@index([draftId])
}

model HousingRefundRequest {
  id           Int                     @id @default(autoincrement())
  draftId      Int
  draft        HousingApplicationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  amount       Decimal                 @db.Decimal(10, 2)
  reason       String?                 @db.VarChar(500)
  status       String                  @default("PENDING")
  adminNote    String?                 @db.VarChar(500)
  resolvedById Int?
  resolvedBy   User?                   @relation("HousingRefundRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  requestedAt  DateTime                @default(now())
  resolvedAt   DateTime?

  @@index([draftId, status, requestedAt])
}

model PaymentBatch {
  id                    Int                @id @default(autoincrement())
  payerUserId           Int?
  payerUser             User?              @relation(fields: [payerUserId], references: [id])
  amount                Decimal            @db.Decimal(10, 2)
  status                PaymentBatchStatus @default(PENDING)
  provider              PaymentProvider    @default(THUNDER)
  idempotencyKey        String             @unique
  slipHash              String?            @unique
  slipPath              String?
  slipAmount            Decimal?           @db.Decimal(10, 2)
  transferAt            DateTime?
  providerTransactionId String?            @unique
  providerResponse      String?
  failureReason         String?
  verifiedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  items PaymentBatchItem[]

  @@index([payerUserId])
  @@index([status])
  @@index([createdAt])
}

model PaymentBatchItem {
  batchId   Int
  batch     PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  billId    Int
  bill      Bill         @relation(fields: [billId], references: [id])
  amount    Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  @@id([batchId, billId])
  @@index([billId])
}

model MaintenanceTicket {
  id                   Int                 @id @default(autoincrement())
  tenantId             Int
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  roomId               Int?
  room                 Room?               @relation(fields: [roomId], references: [id])
  category             MaintenanceCategory @default(OTHER)
  description          String
  contactTime          DateTime?
  status               MaintenanceStatus   @default(PENDING)
  assignedTechnicianId Int?
  note                 String?
  resolvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
}

model Visitor {
  faceRevokedAt       DateTime?
  id                  Int           @id @default(autoincrement())
  tenantId            Int?
  tenant              Tenant?       @relation(fields: [tenantId], references: [id])
  roomId              Int?
  room                Room?         @relation(fields: [roomId], references: [id])
  guestName           String
  requestedTenantName String?
  phone               String?
  citizenId           String?
  citizenIdMasked     String?
  relationship        String?
  age                 Int?
  birthDate           String?
  address             String?
  idCardImagePath     String?
  purpose             String?
  expectedEntryTime   DateTime?
  status              VisitorStatus @default(REGISTERED)
  pdpaConsent         Boolean       @default(false)
  pdpaConsentAt       DateTime?
  expiresAt           DateTime?
  cancelledAt         DateTime?
  qrCodeData          String?
  checkedInAt         DateTime?
  checkedOutAt        DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  logs                 VisitorLog[]
  faceEmbeddings       FaceEmbedding[]
  faceEnrollmentPhotos FaceEnrollmentPhoto[]

  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([expectedEntryTime])
  @@index([expiresAt])
}

model VisitorLog {
  id        Int      @id @default(autoincrement())
  visitorId Int
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  eventType String
  note      String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
}

/**
 * ---------- Notification System Models ----------
 */

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationType {
  RENT_DUE
  RENT_OVERDUE
  MAINTENANCE_COMPLETED
  VISITOR_ARRIVAL
  GENERIC
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

model NotificationProvider {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  channel   NotificationChannel
  config    String // JSON string with provider-specific config (apiKey, senderId, etc.)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  notifications Notification[]

  @@index([name])
  @@index([channel])
}

model NotificationTemplate {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  channel   NotificationChannel
  type      NotificationType
  subject   String?
  body      String // templated body, e.g. "สวัสดี {{name}} ..."
  variables String? // JSON array of variable names used in template
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  notifications Notification[]

  @@index([channel])
  @@index([type])
}

model Notification {
  id                Int                   @id @default(autoincrement())
  providerId        Int?
  provider          NotificationProvider? @relation(fields: [providerId], references: [id])
  templateId        Int?
  template          NotificationTemplate? @relation(fields: [templateId], references: [id])
  tenantId          Int?
  userId            Int?
  channel           NotificationChannel
  type              NotificationType
  recipientPhone    String? // E.164 format for SMS
  recipientEmail    String? // optional for EMAIL
  payload           String? // JSON payload with variables filled or metadata
  status            NotificationStatus    @default(PENDING)
  providerMessageId String?
  attempts          Int                   @default(0)
  lastError         String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  auditLogs   NotificationAuditLog[]
  deadLetters NotificationDeadLetter[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model NotificationAuditLog {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  eventType      String
  payload        String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@index([eventType])
}

model NotificationDeadLetter {
  id             Int          @id @default(autoincrement())
  notificationId Int          @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  reason         String
  details        String?
  createdAt      DateTime     @default(now())

  @@index([reason])
}

model NotificationPreference {
  id        Int                 @id @default(autoincrement())
  tenantId  Int?
  userId    Int?
  channel   NotificationChannel
  optedOut  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([channel])
}

model FaceEmbedding {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId    Int?
  visitor      Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  vector       Float[]
  modelVersion String   @map("model_version")
  qualityScore Float?   @map("quality_score")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([visitorId])
}

model FaceEnrollmentPhoto {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId Int?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  photoPath String   @map("photo_path")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([visitorId])
}
