datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/* ---------- Existing Enums ---------- */
enum Role {
  ADMIN
  STUDENT
  VISITOR
}

enum OcrJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/* ---------- Existing User Model ---------- */
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  firstName String?
  lastName  String?
  version   Int      @default(1) // Optimistic Concurrency Control (OCC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accessLogs          AccessLog[]
  transactions        Transaction[]
  idCardVerifications IdCardVerification[]
  ocrJobs             OcrJob[]
}

/* ---------- New AccessLog Model ---------- */
model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  method    String
  path      String
  ip        String?
  duration  Int?     
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
}

/* ---------- New Transaction Model ---------- */
model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(10,2)
  type        TransactionType
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

/* ---------- Sensitive Document Verification Metadata ---------- */
model IdCardVerification {
  id                 Int      @id @default(autoincrement())
  userId             Int?
  user               User?    @relation(fields: [userId], references: [id])
  imagePath          String?
  isThaiIdCard       Boolean
  citizenIdMasked    String?
  citizenIdHash      String?
  fullNameTh         String?
  birthDateTh        String?
  issueDate          String?
  expiryDate         String?
  idDetected         Boolean  @default(false)
  idPresent          Boolean  @default(false)
  idChecksumValid    Boolean  @default(false)
  reason             String?
  ocrJobId           String?
  processingTimeMs   Int?
  verifiedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  ocrJobs            OcrJob[]  @relation("OcrJobResultVerification")

  @@index([userId])
  @@index([citizenIdHash])
  @@index([verifiedAt])
}

model OcrJob {
  id                   String       @id @default(uuid())
  userId               Int?
  user                 User?        @relation(fields: [userId], references: [id])
  status               OcrJobStatus @default(PENDING)
  imagePath            String
  resultVerificationId Int?
  resultVerification   IdCardVerification? @relation("OcrJobResultVerification", fields: [resultVerificationId], references: [id])
  errorMessage         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  completedAt          DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([resultVerificationId])
}

/* ---------- Transaction Type Enum ---------- */
enum TransactionType {
  INCOME
  EXPENSE
}
