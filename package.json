{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "test": "node tests/run-tests.cjs",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev": "npm run prisma:generate && ts-node src/index.ts",
    "dev:full": "powershell -NoProfile -Command \"$ErrorActionPreference='Stop'; Start-Process -FilePath 'cmd.exe' -ArgumentList '/k', 'npm run dev' -WorkingDirectory '.'; Start-Process -FilePath 'cmd.exe' -ArgumentList '/k', 'cd ..\\smart-dormitory-frontend && npm run dev' -WorkingDirectory '.'\"",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "load:k6": "k6 run tests/load/k6-smoke.js",
    "docker:up": "docker compose -f ../Backend_smart-ocr/docker-compose.yml up -d && docker compose --profile monitoring --profile tunnel up -d",
    "docker:stop": "docker compose --profile monitoring --profile tunnel stop && docker compose -f ../Backend_smart-ocr/docker-compose.yml stop",
    "tunnel:logs": "docker logs -f smart-dormitory-ngrok",
    "tunnel:restart": "docker compose restart ngrok"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.9.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "eslint": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/multer": "^2.1.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.8.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.15",
      "valibot": "1.4.2"
    }
  }
}
